# ---------------------------------------------------------------------------
# FamiliPact — variables d'environnement
#
# Copiez ce fichier en `.env` puis renseignez des valeurs LOCALES.
# Ce fichier ne doit JAMAIS contenir de secret reel : il est versionne.
# Generez chaque secret avec :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------

# --- Base de donnees -------------------------------------------------------
# PostgreSQL 14+ requis.
#
# LOCAL : une instance PostgreSQL sur votre machine.
DATABASE_URL="postgresql://familipact:CHANGE_ME@127.0.0.1:5432/familipact_dev?schema=public"
#
# SUPABASE : FamiliPact utilise Supabase UNIQUEMENT comme hebergeur PostgreSQL.
# Il ne passe ni par l'API REST (PostgREST), ni par Supabase Auth — l'API REST
# est d'ailleurs volontairement fermee sur ce schema (voir docs/deployment.md).
# La chaine se recupere dans : Project Settings > Database > Connection string.
# Elle exige le MOT DE PASSE de la base, qui n'est ni la cle `anon`, ni la cle
# `service_role` : ces cles ne servent qu'a l'API REST, inutilisee ici.
#
#   Application (pooler, port 6543) — recommande en serverless :
#   DATABASE_URL="postgresql://postgres.<ref>:<MOT_DE_PASSE>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
#   Migrations (connexion directe, port 5432) — le pooler ne supporte pas le DDL :
#   DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<MOT_DE_PASSE>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Connexion DIRECTE, utilisee uniquement par le CLI Prisma (migrations).
# Necessaire derriere un pooler transactionnel, qui ne supporte pas le DDL.
# Laissez vide sur une base locale : `DATABASE_URL` suffit alors.
DIRECT_DATABASE_URL=""

# Base jetable utilisee par `prisma migrate dev` pour detecter les derives.
SHADOW_DATABASE_URL="postgresql://familipact:CHANGE_ME@127.0.0.1:5432/familipact_shadow?schema=public"
# Base dediee aux tests d'integration (recreee a chaque execution).
TEST_DATABASE_URL="postgresql://familipact:CHANGE_ME@127.0.0.1:5432/familipact_test?schema=public"

# --- Secrets applicatifs ---------------------------------------------------
# Cle AES-256-GCM (32 octets, base64) chiffrant les secrets TOTP au repos.
# La perte de cette cle rend tous les TOTP existants inutilisables.
TOTP_ENCRYPTION_KEY=""
# Cle HMAC-SHA256 (32 octets, base64) utilisee pour pseudonymiser les adresses IP
# et les user-agents dans les journaux de securite.
LOG_PEPPER_KEY=""

# --- Origine publique ------------------------------------------------------
# Origine exacte servie au navigateur. WebAuthn refuse toute divergence.
APP_ORIGIN="http://localhost:3000"
# Relying Party ID WebAuthn : le domaine SANS schema ni port.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="FamiliPact"

# --- Jobs planifies --------------------------------------------------------
# Jeton partage exige par `/api/jobs/run`, accepte sous deux formes :
#   x-familipact-job-token: <jeton>   (cron systeme, conteneur, appel manuel)
#   Authorization: Bearer <jeton>     (Vercel Cron)
JOB_RUNNER_TOKEN=""
# Vercel Cron n'envoie pas d'en-tete personnalise : il joint `Authorization:
# Bearer $CRON_SECRET`. Sur Vercel, definir CRON_SECRET avec EXACTEMENT la meme
# valeur que JOB_RUNNER_TOKEN. Ailleurs, cette variable est inutile.
CRON_SECRET=""

# --- Divers ----------------------------------------------------------------
# Fuseau IANA propose par defaut a la creation d'une famille.
DEFAULT_FAMILY_TIMEZONE="Europe/Paris"
# `development` | `test` | `production`
NODE_ENV="development"
# Mettre a "1" pour autoriser le seed de demonstration. Refuse en production.
ALLOW_DEV_SEED="1"
