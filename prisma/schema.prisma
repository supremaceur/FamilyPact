/// Journal d'audit, distinct du ledger de points et lui aussi append-only.
/// Ne contient jamais de secret (mot de passe, secret TOTP, code de recuperation,
/// token d'invitation brut). Voir docs/security.md.
model AuditLog {
  id       String  @id @default(uuid(7))
  familyId String?
  family   Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorUser   User?   @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  actorMembershipId String?
  actorMembership   FamilyMembership? @relation("AuditActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  /// Denormalise : l'audit reste lisible meme apres suppression du membre.
  actorLabel String?

  action     AuditAction
  targetType String?
  targetId   String?

  /// Resume lisible, deja localise cote serveur.
  summary String

  /// Contexte structure, filtre par une liste blanche de cles non sensibles.
  metadata Json?

  ipHash          String?
  userAgentDigest String?

  createdAt DateTime @default(now())

  @@index([familyId, createdAt])
  @@index([familyId, action, createdAt])
  @@index([actorUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Infrastructure : jobs & rate limiting
// ---------------------------------------------------------------------------

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Verrou d'idempotence des jobs planifies : `(jobName, runKey)` est unique,
/// donc une double execution sur le meme creneau ne produit pas deux effets.
model JobRun {
  id      String @id @default(uuid(7))
  jobName String
  runKey  String

  status         JobRunStatus @default(RUNNING)
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  itemsProcessed Int          @default(0)
  error          String?

  @@unique([jobName, runKey])
  @@index([jobName, startedAt])
}

/// Compteur de rate limiting en fenetre fixe. Stocke en base pour rester correct
/// avec plusieurs instances applicatives, sans dependance a Redis en V1.
model RateLimitCounter {
  id             String   @id @default(uuid(7))
  bucketKey      String
  windowStartedAt DateTime
  count          Int      @default(0)
  expiresAt      DateTime

  @@unique([bucketKey, windowStartedAt])
  @@index([expiresAt])
}
