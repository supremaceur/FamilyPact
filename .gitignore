# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright
/playwright/.cache

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
.idea
.vscode/*
!.vscode/extensions.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env
.env*.local
.env.development
.env.production
.env.test
!.env.example

# typescript
*.tsbuildinfo

# prisma
/prisma/*.db
/prisma/*.db-journal

# local tooling
/.turbo
/tmp

# prisma client is generated at build time
/src/generated

# playwright
/playwright-report
/test-results

# scratch local, jamais versionne
/scripts/tmp
